{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "price": {
      "type": "integer",
      "required": true
    },
    "inStock": {
      "type": "boolean",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "furniture",
        "light",
        "items",
        "accessories"
      ]
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "mappedBy": "products"
    },
    "description": {
      "type": "text",
      "required": true
    },
    "specs": {
      "type": "component",
      "component": "product.specs",
      "repeatable": true
    },
    "accordions": {
      "type": "component",
      "component": "ui.accordion",
      "repeatable": true
    }
  }
}
